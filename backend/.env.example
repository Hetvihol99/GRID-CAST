# ============================================================
# .env.example — Copy this to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_NAME=Renewable Forecasting Platform
APP_VERSION=1.0.0
ENV=development
DEBUG=true

# ── Database ─────────────────────────────────────────────────
# Local: postgresql://postgres:password@localhost:5432/renewable_db
# Render: postgresql://user:pass@host/dbname
# Supabase: postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/renewable_db

# ── Weather API ───────────────────────────────────────────────
# Open-Meteo is FREE and requires no API key.
# Leave WEATHER_API_KEY empty when using Open-Meteo.
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
WEATHER_API_KEY=

# ── ML Models ────────────────────────────────────────────────
# Relative path from the backend/ directory
MODEL_DIR=ml/trained_models
SOLAR_MODEL_FILE=solar_model.pkl
WIND_MODEL_FILE=wind_model.pkl
SOLAR_SCALER_FILE=scaler_solar.pkl
WIND_SCALER_FILE=scaler_wind.pkl

# ── CORS ─────────────────────────────────────────────────────
# React dev server (Vite default is 5173, CRA is 3000)
# Production: your Vercel URL
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-app.vercel.app

# ── Grid Analysis Thresholds ─────────────────────────────────
# Fraction of demand that triggers each severity level
WATCH_THRESHOLD_FRACTION=0.05
WARNING_THRESHOLD_FRACTION=0.15
CRITICAL_THRESHOLD_FRACTION=0.30

# ── Forecast Settings ─────────────────────────────────────────
FORECAST_HORIZON_HOURS=72
FORECAST_CACHE_TTL_SECONDS=1800

# ── Battery ───────────────────────────────────────────────────
BATTERY_EFFICIENCY=0.90
